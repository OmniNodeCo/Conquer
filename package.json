{
  "name": "conquer-rule-the-globe",
  "productName": "Conquer: Rule the Globe",
  "version": "1.0.0",
  "description": "A desktop grand-strategy game of world conquest: build your nation, raise armies, invade coasts, launch nukes and take 80% of the globe.",
  "author": {
    "name": "Conquer Studio"
  },
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tools/ui-test.mjs",
    "verify": "npm test && node tools/ui-test.mjs",
    "icons": "node tools/make-icons.mjs",
    "build:web": "node tools/build-web.mjs",
    "get:bun": "node tools/get-bun.mjs",
    "build:exe": "node tools/build-exe.mjs",
    "build:all": "node tools/build-web.mjs && node tools/build-exe.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@napi-rs/canvas": "^1.2.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^31.0.1"
  },
  "build": {
    "appId": "com.conquerstudio.ruletheglobe",
    "productName": "Conquer Rule the Globe",
    "copyright": "Copyright © 2026 Conquer Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OmniNodeCo",
        "repo": "Conquer",
        "releaseType": "release"
      }
    ],
    "files": [
      "index.html",
      "src/**/*",
      "electron/**/*",
      "assets/**/*",
      "!**/*.map"
    ],
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "publisherName": "Conquer Studio"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Conquer"
    },
    "mac": {
      "category": "public.app-category.strategy-games",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "build/icons",
      "maintainer": "Conquer Studio <support@conquer.example>"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
